---
import { reviews, reviewSummary } from "../data/reviews";

const stars = (n: number) => Array.from({ length: n });
---

<section class="section border-t border-line bg-ink-900" aria-labelledby="reviews-heading">
  <div class="container-page">
    <div class="reveal flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Reviews</p>
        <h2
          id="reviews-heading"
          class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white"
        >
          What customers say
        </h2>
        <p class="mt-5 text-lead text-pretty text-neutral-300">
          Homeowners, general contractors, and business owners across the Front Range — in their own
          words.
        </p>
      </div>

      <div class="flex items-center gap-6">
        <div class="flex items-baseline gap-2.5">
          <span class="text-5xl font-bold text-white">{reviewSummary.rating}</span>
          <div>
            <div class="flex gap-0.5 text-red-400" aria-hidden="true">
              {
                stars(5).map(() => (
                  <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                  </svg>
                ))
              }
            </div>
            <p class="mt-1 text-sm text-neutral-400">
              {reviewSummary.count} reviews on {reviewSummary.source}
            </p>
          </div>
        </div>

        <div class="hidden gap-2 sm:flex">
          <button
            type="button"
            data-rail-prev
            class="flex size-11 items-center justify-center rounded-lg border border-line-strong bg-white/5 text-white transition-colors hover:border-red-500 hover:bg-red-500"
            aria-label="Previous reviews"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M15 18l-6-6 6-6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            type="button"
            data-rail-next
            class="flex size-11 items-center justify-center rounded-lg border border-line-strong bg-white/5 text-white transition-colors hover:border-red-500 hover:bg-red-500"
            aria-label="More reviews"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M9 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  {/* Full-bleed rail so cards run to the screen edge, Apple/Insta360 style */}
  <div class="mt-12">
    <div
      data-rail
      class="rail px-6 md:px-10"
      tabindex="0"
      role="group"
      aria-label="Customer reviews, scrollable"
    >
      {
        reviews.map((r) => (
          <figure class="card flex h-full flex-col p-7">
            <div class="flex items-center justify-between">
              <div class="flex gap-0.5 text-red-400" aria-hidden="true">
                {stars(r.rating).map(() => (
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
                  </svg>
                ))}
              </div>
              <span class="text-[0.7rem] font-semibold tracking-[0.14em] text-neutral-500 uppercase">
                {r.source}
              </span>
            </div>
            <span class="sr-only">{r.rating} out of 5 stars</span>

            <blockquote class="mt-5 flex-1 text-[1.0625rem] leading-relaxed text-neutral-200">
              “{r.quote}”
            </blockquote>

            <figcaption class="mt-6 border-t border-line pt-5">
              <span class="block font-semibold text-white">{r.name}</span>
              <span class="mt-0.5 block text-sm text-neutral-400">
                {r.date}
                {r.amount && <> · {r.amount} project</>}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="container-page mt-10">
    <a
      href={reviewSummary.href}
      target="_blank"
      rel="noopener noreferrer"
      class="link-red inline-flex items-center gap-2 text-sm font-semibold tracking-wide underline"
    >
      Read all {reviewSummary.count} reviews on {reviewSummary.source}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M7 17L17 7M17 7H9M17 7v8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</section>

<script>
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  const step = () => (rail?.querySelector<HTMLElement>(":scope > *")?.offsetWidth ?? 340) + 20;
  const go = (dir: number) =>
    rail?.scrollBy({
      left: dir * step(),
      behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
    });

  document.querySelector("[data-rail-prev]")?.addEventListener("click", () => go(-1));
  document.querySelector("[data-rail-next]")?.addEventListener("click", () => go(1));
</script>
