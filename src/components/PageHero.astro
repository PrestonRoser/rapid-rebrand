---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-white/10 bg-black">
  <div class="container-page py-20 sm:py-28">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1
      class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-balance text-white sm:text-6xl"
    >
      {title}
    </h1>
    {lead && <p class="mt-5 max-w-2xl text-lg text-pretty text-neutral-400">{lead}</p>}
  </div>
</section>
