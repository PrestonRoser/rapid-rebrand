---
import type { Service } from "../data/site";

interface Props {
  service: Service;
  index?: number;
  detailed?: boolean;
}
const { service, index, detailed = false } = Astro.props;
---

<article
  id={service.slug}
  class="group scroll-mt-24 border border-white/10 bg-neutral-900 p-6 transition-colors hover:border-red-500 sm:p-8"
>
  <div class="flex items-baseline justify-between">
    <h3 class="text-lg font-semibold text-white sm:text-xl">{service.title}</h3>
    {
      index != null && (
        <span class="font-mono text-xs text-neutral-600">{String(index).padStart(2, "0")}</span>
      )
    }
  </div>
  <div class="mt-3 h-px w-10 bg-red-500"></div>
  <p class="mt-4 text-sm leading-relaxed text-neutral-400">{service.summary}</p>

  {
    detailed && (
      <ul class="mt-5 space-y-2 text-sm text-neutral-300">
        {service.points.map((p) => (
          <li class="flex gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 bg-red-500" />
            {p}
          </li>
        ))}
      </ul>
    )
  }
</article>
