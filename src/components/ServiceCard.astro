---
import type { Service } from "../data/site";

interface Props {
  service: Service;
  /** show the capability bullet list */
  detailed?: boolean;
}
const { service, detailed = false } = Astro.props;
---

<article
  id={service.slug}
  class="scroll-mt-24 rounded-xl border border-brand-100 bg-white p-6 transition-colors hover:border-brand-300"
>
  <div class="flex size-11 items-center justify-center rounded-lg bg-brand-50 text-accent-600">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"></path>
    </svg>
  </div>
  <h3 class="mt-4 text-lg font-semibold text-brand-950">{service.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-brand-600">{service.summary}</p>

  {
    detailed && (
      <ul class="mt-4 space-y-1.5 text-sm text-brand-700">
        {service.points.map((p) => (
          <li class="flex gap-2">
            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent-500" />
            {p}
          </li>
        ))}
      </ul>
    )
  }
</article>
