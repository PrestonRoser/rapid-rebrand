---
import type { Service } from "../data/site";

interface Props {
  service: Service;
  index?: number;
  detailed?: boolean;
}
const { service, index, detailed = false } = Astro.props;
---

<article id={service.slug} class="card card-hover scroll-mt-28 p-7 sm:p-8">
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-h3 leading-tight font-bold text-white">{service.title}</h3>
    {
      index != null && (
        <span class="mt-1 font-mono text-sm text-neutral-600">
          {String(index).padStart(2, "0")}
        </span>
      )
    }
  </div>
  <span class="keyline mt-4"></span>
  <p class="mt-5 text-[1.0625rem] leading-relaxed text-neutral-300">{service.summary}</p>

  {
    detailed && (
      <ul class="mt-6 space-y-3">
        {service.points.map((p) => (
          <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-neutral-400">
            <svg
              class="mt-1 size-4 shrink-0 text-red-400"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10.5l4 4 8-9"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {p}
          </li>
        ))}
      </ul>
    )
  }
</article>
