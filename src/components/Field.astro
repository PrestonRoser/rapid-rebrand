---
// Every form control on the site renders through this component so the two
// forms cannot drift apart in label wording, spacing, or focus styling.
interface Props {
  id: string;
  label: string;
  type?: "text" | "tel" | "email" | "select" | "textarea";
  autocomplete?: string;
  required?: boolean;
  rows?: number;
  options?: string[];
  class?: string;
}

const {
  id,
  label,
  type = "text",
  autocomplete,
  required = false,
  rows = 5,
  options = [],
  class: className = "",
} = Astro.props;

const control =
  "mt-2 w-full rounded-lg border border-line-strong bg-ink-800 px-4 py-3 text-[1.0625rem] text-white transition-colors focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/35";
---

<div class={className}>
  <label for={id} class="text-sm font-semibold text-neutral-300">
    {label}{!required && <span class="ml-1.5 font-normal text-neutral-500">(optional)</span>}
  </label>

  {
    type === "textarea" ? (
      <textarea id={id} name={id} rows={rows} required={required} class={control} />
    ) : type === "select" ? (
      <select id={id} name={id} required={required} class={control}>
        {options.map((option) => (
          <option>{option}</option>
        ))}
      </select>
    ) : (
      <input
        id={id}
        name={id}
        type={type}
        autocomplete={autocomplete}
        required={required}
        class={control}
      />
    )
  }
</div>
