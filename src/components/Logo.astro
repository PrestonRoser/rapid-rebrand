---
/**
 * The supplied logo is a stacked lockup (RAPID over "energy solutions",
 * ~1.77:1). Shrunk to nav height the sub-wordmark becomes illegible, so the
 * header pairs the R mark with a typeset wordmark, and the full lockup is
 * used where there's room (footer).
 *
 * `logo-dark.webp` is a recoloured variant — the original's "APID" is black
 * and would disappear on this page.
 */
interface Props {
  variant?: "mark" | "full";
  class?: string;
}
const { variant = "mark", class: className = "" } = Astro.props;
---

{
  variant === "full" ? (
    <img
      src="/images/logo-dark.webp"
      alt="Rapid Energy Solutions"
      width="700"
      height="395"
      class={`h-auto w-44 ${className}`}
    />
  ) : (
    <span class={`inline-flex items-center gap-3 ${className}`}>
      <img
        src="/images/mark.webp"
        alt=""
        aria-hidden="true"
        width="256"
        height="256"
        class="h-9 w-9 shrink-0"
      />
      <span class="leading-none">
        <span class="block text-[0.95rem] font-extrabold tracking-[0.02em] text-white uppercase">
          Rapid
        </span>
        <span class="mt-[3px] block text-[0.6rem] font-bold tracking-[0.22em] text-red-400 uppercase">
          Energy Solutions
        </span>
      </span>
    </span>
  )
}
