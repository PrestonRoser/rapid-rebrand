---
/**
 * The brand lockup, recoloured for a dark background: the original's "APID" is
 * black and would disappear against this page.
 *
 * Header and footer render the same file at different sizes. The header is
 * height-constrained and the footer width-constrained, so the caller supplies
 * both dimensions rather than fighting a default here. The art is 700x395, and
 * the "energy solutions" line is the first thing to give out as it shrinks,
 * which is what sets the floor on the header size.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<img
  src="/images/logo-dark.webp"
  alt="Rapid Energy Solutions"
  width="700"
  height="395"
  class={className}
/>
