---
interface Props {
  class?: string;
  /** hide the sub-label (e.g. in a tight nav) */
  compact?: boolean;
}
const { class: className = "", compact = false } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg width="30" height="30" viewBox="0 0 30 30" role="img" aria-label="Rapid Energy Solutions">
    <rect x="0.5" y="0.5" width="29" height="29" rx="2" fill="none" stroke="rgba(255,255,255,0.35)"
    ></rect>
    <path d="M17 5 8 17h5.5L12 25l11-13h-6l1-7Z" fill="var(--color-red-500)"></path>
  </svg>
  <span class="leading-none">
    <span class="block text-sm font-bold tracking-tight text-white uppercase">
      Rapid Energy Solutions
    </span>
    {
      !compact && (
        <span class="mt-1 block text-[0.6rem] font-semibold tracking-[0.18em] text-neutral-500 uppercase">
          Electrical Contractor · Platteville, CO
        </span>
      )
    }
  </span>
</span>
