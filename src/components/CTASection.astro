---
import { site } from "../data/site";

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "Let's build a brighter future together",
  body = "Tell us about your project and a team member will get back to you as soon as possible.",
} = Astro.props;
---

<section class="bg-brand-950">
  <div class="container-page py-20 text-center">
    <h2
      class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl"
    >
      {heading}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-pretty text-brand-300">{body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/contact" class="btn btn-primary">Request service</a>
      <a href={site.phoneHref} class="btn btn-on-dark">Call {site.phone}</a>
    </div>
  </div>
</section>
