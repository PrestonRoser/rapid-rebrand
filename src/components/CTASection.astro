---
import { site } from "../data/site";

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
}
const {
  eyebrow = "Get started",
  heading = "Let's build a brighter future together",
  body = "Tell us about your project and a team member will get back to you as soon as possible.",
} = Astro.props;
---

<section class="relative overflow-hidden border-t border-line bg-ink-900">
  <div
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(900px 420px at 50% 118%, rgba(215,4,17,0.20), transparent 68%)"
    aria-hidden="true"
  >
  </div>
  <div class="container-page relative py-24 text-center">
    <p class="eyebrow">{eyebrow}</p>
    <h2
      class="mx-auto mt-5 max-w-3xl text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white"
    >
      {heading}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-lead text-pretty text-neutral-300">{body}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/contact" class="btn btn-solid">Request service</a>
      <a href={site.phoneHref} class="btn">Call {site.phone}</a>
    </div>
  </div>
</section>
