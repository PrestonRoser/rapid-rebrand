---
import { site } from "../data/site";

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
}
const {
  eyebrow = "Get started",
  heading = "Let's build a brighter future together",
  body = "Tell us about your project and a team member will get back to you as soon as possible.",
} = Astro.props;
---

<section class="border-t border-white/10 bg-black">
  <div class="container-page py-20 text-center">
    <p class="eyebrow">{eyebrow}</p>
    <h2
      class="mx-auto mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl"
    >
      {heading}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-pretty text-neutral-400">{body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/contact" class="btn">Request service</a>
      <a href={site.phoneHref} class="btn">Call {site.phone}</a>
    </div>
  </div>
</section>
