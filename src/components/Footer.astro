---
import { cityStateZip, nav, services, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-black">
  {/* Address + phone band (Shamrock pattern) */}
  <div class="container-page flex flex-col gap-6 py-12 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="eyebrow">Rapid Energy Solutions LLC</p>
      <address class="mt-3 text-lg leading-snug text-white not-italic">
        {site.address.street}<br />
        {cityStateZip}
      </address>
    </div>
    <div class="sm:text-right">
      <a href={site.phoneHref} class="block text-2xl font-bold text-white hover:text-red-500">
        {site.phone}
      </a>
      <a
        href={`mailto:${site.email}`}
        class="mt-1 block text-sm text-neutral-400 hover:text-red-500"
      >
        {site.email}
      </a>
      <p class="mt-1 text-sm text-neutral-500">{site.hours}</p>
    </div>
  </div>

  <hr class="rule" />

  {/* Link columns (Stripe pattern) */}
  <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <nav aria-label="Site">
      <h2 class="text-xs font-semibold tracking-[0.15em] text-neutral-500 uppercase">Company</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-neutral-300 hover:text-red-500">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Services">
      <h2 class="text-xs font-semibold tracking-[0.15em] text-neutral-500 uppercase">Services</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={`/services#${s.slug}`} class="text-neutral-300 hover:text-red-500">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-xs font-semibold tracking-[0.15em] text-neutral-500 uppercase">
        Service area
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm text-neutral-300">
        {site.serviceAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-[0.15em] text-neutral-500 uppercase">Resources</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a href="/careers" class="text-neutral-300 hover:text-red-500"
            >Careers &amp; internships</a
          >
        </li>
        <li><a href="#" class="text-neutral-300 hover:text-red-500">Employee portal</a></li>
        <li>
          <a href={`mailto:${site.email}`} class="text-neutral-300 hover:text-red-500">
            Request a quote
          </a>
        </li>
      </ul>
    </div>
  </div>

  <hr class="rule" />

  <div
    class="container-page flex flex-col gap-2 py-6 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} {site.legalName}. All rights reserved.</p>
    <p>Locally owned &amp; operated in {site.address.city}, Colorado.</p>
  </div>
</footer>
