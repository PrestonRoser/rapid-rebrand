---
import Logo from "./Logo.astro";
import { cityStateZip, nav, services, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink-900">
  {/* Address + phone band */}
  <div class="container-page grid gap-10 py-14 lg:grid-cols-[auto_1fr_auto] lg:items-center">
    <Logo variant="full" />

    <address class="text-lg leading-snug text-neutral-300 not-italic lg:pl-6">
      {site.address.street}<br />
      {cityStateZip}
    </address>

    <div class="lg:text-right">
      <a
        href={site.phoneHref}
        class="block text-3xl font-bold text-white transition-colors hover:text-red-400"
      >
        {site.phone}
      </a>
      <a
        href={`mailto:${site.email}`}
        class="mt-1.5 block text-neutral-300 transition-colors hover:text-red-400"
      >
        {site.email}
      </a>
      <p class="mt-1.5 text-neutral-500">{site.hours}</p>
    </div>
  </div>

  <hr class="rule" />

  {/* Link columns */}
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <nav aria-label="Site">
      <h2 class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Company</h2>
      <ul class="mt-5 space-y-3">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-neutral-300 transition-colors hover:text-red-400">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Services">
      <h2 class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Services</h2>
      <ul class="mt-5 space-y-3">
        {
          services.map((s) => (
            <li>
              <a
                href={`/services#${s.slug}`}
                class="text-neutral-300 transition-colors hover:text-red-400"
              >
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Service area</h2>
      <ul class="mt-5 space-y-3 text-neutral-300">
        {site.serviceAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Resources</h2>
      <ul class="mt-5 space-y-3">
        <li>
          <a href="/careers" class="text-neutral-300 transition-colors hover:text-red-400">
            Careers &amp; internships
          </a>
        </li>
        <li>
          <a href="#" class="text-neutral-300 transition-colors hover:text-red-400">
            Employee portal
          </a>
        </li>
        <li>
          <a
            href={`mailto:${site.email}`}
            class="text-neutral-300 transition-colors hover:text-red-400"
          >
            Request a quote
          </a>
        </li>
      </ul>
    </div>
  </div>

  <hr class="rule" />

  <div
    class="container-page flex flex-col gap-2 py-7 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between"
  >
    <p>&copy; {year} {site.legalName}. All rights reserved.</p>
    <p>Locally owned &amp; operated in {site.address.city}, Colorado.</p>
  </div>
</footer>
