---
import Logo from "./Logo.astro";
import { nav, site } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line bg-ink-900/85 backdrop-blur-md">
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label={`${site.legalName} home`}>
      <Logo />
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "relative py-1 text-sm font-semibold tracking-wide transition-colors",
              isActive(item.href)
                ? "text-white after:absolute after:-bottom-0.5 after:left-0 after:h-0.5 after:w-full after:bg-red-500"
                : "text-neutral-300 hover:text-red-400",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={site.phoneHref}
        class="text-[0.95rem] font-bold text-white transition-colors hover:text-red-400"
      >
        {site.phone}
      </a>
      <a href="/contact" class="btn btn-sm btn-solid">Request service</a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-lg border border-line-strong p-2.5 text-white lg:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-line bg-ink-900 lg:hidden">
    <nav class="container-page flex flex-col py-3" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="border-b border-white/5 py-4 text-base font-semibold text-white"
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.phoneHref} class="py-4 text-base font-bold text-red-400">
        {site.phone}
      </a>
      <a href="/contact" class="btn btn-solid my-3">Request service</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const willOpen = menu?.hasAttribute("hidden");
    if (willOpen) menu?.removeAttribute("hidden");
    else menu?.setAttribute("hidden", "");
    toggle.setAttribute("aria-expanded", String(!!willOpen));
  });
</script>
