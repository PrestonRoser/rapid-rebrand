---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { cityStateZip, site } from "../data/site";

const fieldClass =
  "mt-2 w-full rounded-lg border border-line-strong bg-ink-800 px-4 py-3 text-[1.0625rem] text-white placeholder:text-neutral-600 transition-colors focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/35";
const labelClass = "text-sm font-semibold text-neutral-300";

const details = [
  ["Call", site.phone, site.phoneHref],
  ["Email", site.email, `mailto:${site.email}`],
];
---

<Layout
  title="Contact"
  description="Request electrical service from Rapid Energy Solutions in Platteville, Colorado. Call 970-535-2381 or send us a message."
>
  <PageHero
    eyebrow="Contact"
    title="Have any questions?"
    lead="Let us know and a team member will get back to you as soon as possible."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start lg:gap-20">
      <div class="divide-y divide-line">
        {
          details.map(([label, value, href]) => (
            <div class="py-6 first:pt-0">
              <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">{label}</p>
              <a
                href={href}
                class="mt-2 block text-2xl font-bold break-words text-white transition-colors hover:text-red-400"
              >
                {value}
              </a>
            </div>
          ))
        }
        <div class="py-6">
          <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Visit</p>
          <address class="mt-2 text-lg text-neutral-200 not-italic">
            {site.address.street}<br />
            {cityStateZip}
          </address>
        </div>
        <div class="py-6 last:pb-0">
          <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Hours</p>
          <p class="mt-2 text-lg text-neutral-200">{site.hours}</p>
        </div>
      </div>

      {/* Wire `action` to a form handler (Formspree, Vercel/Netlify Forms, etc.) before launch. */}
      <form method="post" action="#" class="card p-7 sm:p-9">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClass}>Name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={fieldClass}
            />
          </div>
          <div>
            <label for="phone" class={labelClass}>Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" class={fieldClass} />
          </div>
        </div>
        <div class="mt-5">
          <label for="email" class={labelClass}>Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class={fieldClass}
          />
        </div>
        <div class="mt-5">
          <label for="type" class={labelClass}>Project type</label>
          <select id="type" name="type" class={fieldClass}>
            <option>Residential</option>
            <option>Commercial</option>
            <option>Industrial</option>
            <option>Hauling &amp; dirt work</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="mt-5">
          <label for="message" class={labelClass}>How can we help?</label>
          <textarea id="message" name="message" rows="5" required class={fieldClass}></textarea>
        </div>
        <button type="submit" class="btn btn-solid mt-7 w-full sm:w-auto">Send message</button>
        <p class="mt-4 text-sm text-neutral-400">
          Prefer to talk it through? Call{" "}
          <a href={site.phoneHref} class="link-red font-semibold underline">{site.phone}</a>.
        </p>
      </form>
    </div>
  </section>
</Layout>
