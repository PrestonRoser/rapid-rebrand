---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { cityStateZip, site } from "../data/site";

const fieldClass =
  "mt-1.5 w-full rounded-lg border border-brand-200 bg-white px-3.5 py-2.5 text-sm text-brand-950 placeholder:text-brand-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-accent-500/40";
---

<Layout
  title="Contact"
  description="Request electrical service from Rapid Energy Solutions in Platteville, Colorado. Call 970-535-2381 or send us a message."
>
  <PageHero
    eyebrow="Contact"
    title="Have any questions?"
    lead="Let us know and a team member will get back to you as soon as possible."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="space-y-6">
        <div>
          <h2 class="text-xs font-semibold tracking-[0.15em] text-brand-500 uppercase">Call</h2>
          <a
            href={site.phoneHref}
            class="mt-1 block text-2xl font-semibold text-brand-950 hover:text-brand-600"
          >
            {site.phone}
          </a>
        </div>
        <div>
          <h2 class="text-xs font-semibold tracking-[0.15em] text-brand-500 uppercase">Email</h2>
          <a
            href={`mailto:${site.email}`}
            class="mt-1 block text-lg font-medium text-brand-950 hover:text-brand-600"
          >
            {site.email}
          </a>
        </div>
        <div>
          <h2 class="text-xs font-semibold tracking-[0.15em] text-brand-500 uppercase">Visit</h2>
          <address class="mt-1 text-brand-800 not-italic">
            {site.address.street}<br />
            {cityStateZip}
          </address>
        </div>
        <div>
          <h2 class="text-xs font-semibold tracking-[0.15em] text-brand-500 uppercase">Hours</h2>
          <p class="mt-1 text-brand-800">{site.hours}</p>
        </div>
      </div>

      {/* Wire `action` to a form handler (Formspree, Vercel/Netlify Forms, etc.) before launch. */}
      <form method="post" action="#" class="rounded-xl border border-brand-100 bg-white p-6 sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-brand-800">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={fieldClass}
            />
          </div>
          <div>
            <label for="phone" class="text-sm font-medium text-brand-800">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" class={fieldClass} />
          </div>
        </div>
        <div class="mt-4">
          <label for="email" class="text-sm font-medium text-brand-800">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class={fieldClass}
          />
        </div>
        <div class="mt-4">
          <label for="type" class="text-sm font-medium text-brand-800">Project type</label>
          <select id="type" name="type" class={fieldClass}>
            <option>Residential</option>
            <option>Commercial</option>
            <option>Industrial</option>
            <option>Hauling &amp; dirt work</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="mt-4">
          <label for="message" class="text-sm font-medium text-brand-800">How can we help?</label>
          <textarea id="message" name="message" rows="4" required class={fieldClass}></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-6 w-full sm:w-auto">Send message</button>
        <p class="mt-3 text-xs text-brand-500">
          Prefer to talk it through? Call <a
            href={site.phoneHref}
            class="font-medium text-brand-700 underline">{site.phone}</a
          >.
        </p>
      </form>
    </div>
  </section>
</Layout>
