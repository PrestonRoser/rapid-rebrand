---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Field from "../components/Field.astro";
import { cityStateZip, services, site } from "../data/site";

const contactMethods = [
  ["Call", site.phone, site.phoneHref],
  ["Email", site.email, `mailto:${site.email}`],
];
---

<Layout
  title="Contact"
  description="Request electrical service from Rapid Energy Solutions in Platteville, Colorado. Call 970-535-2381 or send us a message."
>
  <PageHero
    eyebrow="Contact"
    title="Have any questions?"
    lead="Let us know and a team member will get back to you as soon as possible."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start lg:gap-20">
      {/* min-w-0: the email at text-2xl floors this column past a 360px viewport without it. */}
      <div class="min-w-0 divide-y divide-line">
        {
          contactMethods.map(([label, value, href]) => (
            <div class="py-6 first:pt-0">
              <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">{label}</p>
              <a
                href={href}
                class="mt-2 block text-2xl font-bold break-words text-white transition-colors hover:text-red-400"
              >
                {value}
              </a>
            </div>
          ))
        }
        <div class="py-6">
          <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Visit</p>
          <address class="mt-2 text-lg text-neutral-200 not-italic">
            {site.address.street}<br />
            {cityStateZip}
          </address>
        </div>
        <div class="py-6 last:pb-0">
          <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">Hours</p>
          <p class="mt-2 text-lg text-neutral-200">{site.hours}</p>
        </div>
      </div>

      {/* action is a placeholder. Point it at the form handler before launch. */}
      <form method="post" action="#" class="card p-7 sm:p-9">
        <div class="grid gap-5 sm:grid-cols-2">
          <Field id="name" label="Full name" autocomplete="name" required />
          <Field id="phone" label="Phone" type="tel" autocomplete="tel" required />
        </div>
        <Field id="email" label="Email" type="email" autocomplete="email" required class="mt-5" />
        <Field
          id="type"
          label="Project type"
          type="select"
          required
          class="mt-5"
          options={[...services.map((service) => service.title), "Something else"]}
        />
        <Field id="message" label="How can we help?" type="textarea" required class="mt-5" />

        <button type="submit" class="btn btn-solid mt-7 w-full sm:w-auto">Send message</button>
        <p class="mt-4 text-sm text-neutral-400">
          Prefer to talk it through? Call{" "}
          <a href={site.phoneHref} class="link-red font-semibold underline">{site.phone}</a>.
        </p>
      </form>
    </div>
  </section>
</Layout>
