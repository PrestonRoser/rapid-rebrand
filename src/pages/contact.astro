---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { cityStateZip, site } from "../data/site";

const fieldClass =
  "mt-1.5 w-full rounded-sm border border-white/15 bg-black px-3.5 py-2.5 text-sm text-white placeholder:text-neutral-600 focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500";
const labelClass = "text-xs font-semibold tracking-[0.1em] text-neutral-400 uppercase";

const details = [
  ["Call", site.phone, site.phoneHref],
  ["Email", site.email, `mailto:${site.email}`],
];
---

<Layout
  title="Contact"
  description="Request electrical service from Rapid Energy Solutions in Platteville, Colorado. Call 970-535-2381 or send us a message."
>
  <PageHero
    eyebrow="Contact"
    title="Have any questions?"
    lead="Let us know and a team member will get back to you as soon as possible."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start lg:gap-16">
      <div class="divide-y divide-white/10">
        {
          details.map(([label, value, href]) => (
            <div class="py-5 first:pt-0">
              <p class={labelClass}>{label}</p>
              <a
                href={href}
                class="mt-1.5 block text-xl font-semibold text-white hover:text-red-500"
              >
                {value}
              </a>
            </div>
          ))
        }
        <div class="py-5">
          <p class={labelClass}>Visit</p>
          <address class="mt-1.5 text-neutral-300 not-italic">
            {site.address.street}<br />
            {cityStateZip}
          </address>
        </div>
        <div class="py-5 last:pb-0">
          <p class={labelClass}>Hours</p>
          <p class="mt-1.5 text-neutral-300">{site.hours}</p>
        </div>
      </div>

      {/* Wire `action` to a form handler (Formspree, Vercel/Netlify Forms, etc.) before launch. */}
      <form method="post" action="#" class="border border-white/10 bg-neutral-900 p-6 sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClass}>Name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={fieldClass}
            />
          </div>
          <div>
            <label for="phone" class={labelClass}>Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" class={fieldClass} />
          </div>
        </div>
        <div class="mt-4">
          <label for="email" class={labelClass}>Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class={fieldClass}
          />
        </div>
        <div class="mt-4">
          <label for="type" class={labelClass}>Project type</label>
          <select id="type" name="type" class={fieldClass}>
            <option>Residential</option>
            <option>Commercial</option>
            <option>Industrial</option>
            <option>Hauling &amp; dirt work</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="mt-4">
          <label for="message" class={labelClass}>How can we help?</label>
          <textarea id="message" name="message" rows="4" required class={fieldClass}></textarea>
        </div>
        <button type="submit" class="btn mt-6 w-full sm:w-auto">Send message</button>
        <p class="mt-3 text-xs text-neutral-500">
          Prefer to talk it through? Call{" "}
          <a href={site.phoneHref} class="link-red font-medium underline">{site.phone}</a>.
        </p>
      </form>
    </div>
  </section>
</Layout>
