---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CTASection from "../components/CTASection.astro";
import { fullAddress, site, values } from "../data/site";

const glance = [
  ["Headquarters", fullAddress],
  ["Hours", site.hours],
  ["Service area", site.serviceAreas.join(", ")],
  ["Work", "Residential · Commercial · Industrial"],
];
---

<Layout
  title="About"
  description="Rapid Energy Solutions is a locally owned and operated electrical contractor in Platteville, Colorado, committed to its employees, families, and communities."
>
  <PageHero
    eyebrow="About"
    title="Locally owned and operated"
    lead="Rapid Energy Solutions is built on a commitment to support our employees, their families, and the communities we serve."
  />

  <section class="section">
    <div
      class="container-page reveal grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:items-start lg:gap-20"
    >
      <div>
        <p class="eyebrow">Our story</p>
        <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white">
          Meticulous work for impeccable results
        </h2>
        <div class="mt-7 space-y-6 text-lead text-pretty text-neutral-300">
          <p>
            Rising demand for quality electricians is real, and so is the gap in service that comes
            with it. We started Rapid Energy Solutions to close that gap: to give homeowners,
            businesses, and industrial clients a contractor who shows up, communicates clearly, and
            does the work right.
          </p>
          <p>
            Whether it's a small project, a large remodel, a brand-new build, or a commercial job,
            we bring the same meticulous attention to detail and dedication to customer
            satisfaction. We work closely with each client to tailor solutions that align with their
            individual needs, budgets, and desired outcomes.
          </p>
          <p>
            Our team provides technical expertise, project management, and ongoing support, because
            the relationship shouldn't end when the final inspection is signed.
          </p>
        </div>
      </div>

      <aside class="card p-8">
        <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">At a glance</p>
        <dl class="mt-6 divide-y divide-line">
          {
            glance.map(([label, value]) => (
              <div class="py-5 first:pt-0 last:pb-0">
                <dt class="text-xs font-semibold tracking-[0.12em] text-neutral-500 uppercase">
                  {label}
                </dt>
                <dd class="mt-1.5 text-[1.0625rem] font-medium text-white">{value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  <section class="section border-t border-line bg-ink-900">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">Safety</p>
        <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white">
          Protecting lives and preserving values
        </h2>
        <p class="mt-5 text-lead text-pretty text-neutral-300">
          Safety is central to our operations. We invest in safety trainings and run regular safety
          inspections to protect our employees, our clients, and our communities.
        </p>
      </div>
      <dl class="reveal mt-14 grid gap-5 md:grid-cols-3">
        {
          values.map((value) => (
            <div class="card p-8">
              <dt class="text-h3 font-bold text-white">{value.title}</dt>
              <span class="keyline mt-4" />
              <dd class="mt-5 text-[1.0625rem] leading-relaxed text-neutral-300">{value.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CTASection />
</Layout>
