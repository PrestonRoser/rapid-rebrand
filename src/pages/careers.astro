---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site, values } from "../data/site";

const fieldClass =
  "mt-1.5 w-full rounded-sm border border-white/15 bg-black px-3.5 py-2.5 text-sm text-white placeholder:text-neutral-600 focus:border-red-500 focus:outline-none focus:ring-1 focus:ring-red-500";
const labelClass = "text-xs font-semibold tracking-[0.1em] text-neutral-400 uppercase";
---

<Layout
  title="Careers"
  description="Join the Rapid Energy Solutions team in Platteville, Colorado. Electricians and apprentices — plus an internship program for students."
>
  <PageHero
    eyebrow="Careers"
    title="Join the Rapid team"
    lead="Ready to be part of the Rapid team? Tell us about yourself and one of our team members will reach out."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start lg:gap-16">
      <div class="space-y-8">
        <div>
          <p class="eyebrow">Why Rapid</p>
          <h2 class="mt-4 text-2xl font-semibold tracking-tight text-white">What we're building</h2>
          <p class="mt-3 text-pretty text-neutral-400">
            We're a locally owned contractor committed to our employees, their families, and our
            communities — with real investment in safety, training, and the people doing the work.
          </p>
        </div>

        <div class="border border-red-500/40 bg-red-500/10 p-5">
          <h3 class="font-semibold text-white">Still in school?</h3>
          <p class="mt-1 text-sm text-neutral-300">
            Apply to our internship program and kickstart your career in the trades.
          </p>
        </div>

        <dl class="divide-y divide-white/10">
          {
            values.map((v) => (
              <div class="py-4 first:pt-0">
                <dt class="font-semibold text-white">{v.title}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-neutral-400">{v.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* Wire `action` to your applicant intake (email, ATS, or form handler) before launch. */}
      <form method="post" action="#" class="border border-white/10 bg-neutral-900 p-6 sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClass}>Full name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={fieldClass}
            />
          </div>
          <div>
            <label for="phone" class={labelClass}>Phone</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              required
              class={fieldClass}
            />
          </div>
        </div>
        <div class="mt-4">
          <label for="email" class={labelClass}>Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class={fieldClass}
          />
        </div>
        <div class="mt-4">
          <label for="role" class={labelClass}>I'm applying as</label>
          <select id="role" name="role" class={fieldClass}>
            <option>Journeyman electrician</option>
            <option>Apprentice electrician</option>
            <option>Laborer / dirt work</option>
            <option>Intern (student)</option>
            <option>Office / operations</option>
          </select>
        </div>
        <div class="mt-4">
          <label for="about" class={labelClass}>Tell us about your experience</label>
          <textarea id="about" name="about" rows="4" required class={fieldClass}></textarea>
        </div>
        <button type="submit" class="btn mt-6 w-full sm:w-auto">Submit application</button>
        <p class="mt-3 text-xs text-neutral-500">
          Questions? Email{" "}
          <a href={`mailto:${site.email}`} class="link-red font-medium underline">{site.email}</a>.
        </p>
      </form>
    </div>
  </section>
</Layout>
