---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site, values } from "../data/site";

const fieldClass =
  "mt-1.5 w-full rounded-lg border border-brand-200 bg-white px-3.5 py-2.5 text-sm text-brand-950 placeholder:text-brand-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-accent-500/40";
---

<Layout
  title="Careers"
  description="Join the Rapid Energy Solutions team in Platteville, Colorado. Electricians and apprentices — plus an internship program for students."
>
  <PageHero
    eyebrow="Careers"
    title="Join our team"
    lead="Ready to be part of the Rapid team? Tell us about yourself and one of our team members will reach out."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-brand-950">What we're building</h2>
          <p class="mt-3 text-pretty text-brand-600">
            We're a locally owned contractor committed to our employees, their families, and our
            communities. That means real investment in safety, training, and the people doing the
            work.
          </p>
        </div>

        <div class="rounded-xl border border-accent-500/40 bg-accent-500/10 p-5">
          <h3 class="font-semibold text-brand-950">Still in school?</h3>
          <p class="mt-1 text-sm text-brand-700">
            Apply to our internship program and kickstart your career in the trades.
          </p>
        </div>

        <dl class="grid gap-4">
          {
            values.map((v) => (
              <div>
                <dt class="font-semibold text-brand-950">{v.title}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-brand-600">{v.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* Wire `action` to your applicant intake (email, ATS, or form handler) before launch. */}
      <form method="post" action="#" class="rounded-xl border border-brand-100 bg-white p-6 sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-brand-800">Full name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={fieldClass}
            />
          </div>
          <div>
            <label for="phone" class="text-sm font-medium text-brand-800">Phone</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              required
              class={fieldClass}
            />
          </div>
        </div>
        <div class="mt-4">
          <label for="email" class="text-sm font-medium text-brand-800">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class={fieldClass}
          />
        </div>
        <div class="mt-4">
          <label for="role" class="text-sm font-medium text-brand-800">I'm applying as</label>
          <select id="role" name="role" class={fieldClass}>
            <option>Journeyman electrician</option>
            <option>Apprentice electrician</option>
            <option>Laborer / dirt work</option>
            <option>Intern (student)</option>
            <option>Office / operations</option>
          </select>
        </div>
        <div class="mt-4">
          <label for="about" class="text-sm font-medium text-brand-800">
            Tell us about your experience
          </label>
          <textarea id="about" name="about" rows="4" required class={fieldClass}></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-6 w-full sm:w-auto"
          >Submit application</button
        >
        <p class="mt-3 text-xs text-brand-500">
          Questions? Email <a
            href={`mailto:${site.email}`}
            class="font-medium text-brand-700 underline">{site.email}</a
          >.
        </p>
      </form>
    </div>
  </section>
</Layout>
