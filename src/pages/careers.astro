---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Field from "../components/Field.astro";
import { site, values } from "../data/site";
---

<Layout
  title="Careers"
  description="Join the Rapid Energy Solutions team in Platteville, Colorado. Journeyman electricians, apprentices, laborers, and office staff."
>
  <PageHero
    eyebrow="Careers"
    title="Join the Rapid team"
    lead="Ready to be part of the Rapid team? Tell us about yourself and one of our team members will reach out."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start lg:gap-20">
      <div class="space-y-10">
        <div>
          <p class="eyebrow">Why Rapid</p>
          <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-white">
            What we're building
          </h2>
          <p class="mt-5 text-lead text-pretty text-neutral-300">
            We're a locally owned contractor committed to our employees, their families, and our
            communities, with real investment in safety, training, and the people doing the work.
          </p>
        </div>

        <div class="rounded-xl border border-red-500/45 bg-red-500/10 p-6">
          <h3 class="text-h3 font-bold text-white">New to the trade?</h3>
          <p class="mt-2 text-[1.0625rem] text-neutral-200">
            We take on apprentices. Tell us where you are in your training and apply below.
          </p>
        </div>

        <dl class="divide-y divide-line">
          {
            values.map((value) => (
              <div class="py-5 first:pt-0">
                <dt class="text-lg font-bold text-white">{value.title}</dt>
                <dd class="mt-1.5 text-[1.0625rem] leading-relaxed text-neutral-300">
                  {value.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* action is a placeholder. Point it at the applicant intake before launch. */}
      <form method="post" action="#" class="card p-7 sm:p-9">
        <div class="grid gap-5 sm:grid-cols-2">
          <Field id="name" label="Full name" autocomplete="name" required />
          <Field id="phone" label="Phone" type="tel" autocomplete="tel" required />
        </div>
        <Field id="email" label="Email" type="email" autocomplete="email" required class="mt-5" />
        <Field
          id="role"
          label="I'm applying as"
          type="select"
          required
          class="mt-5"
          options={[
            "Journeyman electrician",
            "Apprentice electrician",
            "Laborer or dirt work",
            "Office or operations",
          ]}
        />
        <Field
          id="experience"
          label="Tell us about your experience"
          type="textarea"
          required
          class="mt-5"
        />

        <button type="submit" class="btn btn-solid mt-7 w-full sm:w-auto">
          Submit application
        </button>
        <p class="mt-4 text-sm text-neutral-400">
          Questions? Email{" "}
          <a href={`mailto:${site.email}`} class="link-red font-semibold underline">{site.email}</a
          >.
        </p>
      </form>
    </div>
  </section>
</Layout>
