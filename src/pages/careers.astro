---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site, values } from "../data/site";

const fieldClass =
  "mt-2 w-full rounded-lg border border-line-strong bg-ink-800 px-4 py-3 text-[1.0625rem] text-white placeholder:text-neutral-600 transition-colors focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500/35";
const labelClass = "text-sm font-semibold text-neutral-300";
---

<Layout
  title="Careers"
  description="Join the Rapid Energy Solutions team in Platteville, Colorado. Electricians and apprentices — plus an internship program for students."
>
  <PageHero
    eyebrow="Careers"
    title="Join the Rapid team"
    lead="Ready to be part of the Rapid team? Tell us about yourself and one of our team members will reach out."
  />

  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-start lg:gap-20">
      <div class="space-y-10">
        <div>
          <p class="eyebrow">Why Rapid</p>
          <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-white">
            What we're building
          </h2>
          <p class="mt-5 text-lead text-pretty text-neutral-300">
            We're a locally owned contractor committed to our employees, their families, and our
            communities — with real investment in safety, training, and the people doing the work.
          </p>
        </div>

        <div class="rounded-xl border border-red-500/45 bg-red-500/10 p-6">
          <h3 class="text-h3 font-bold text-white">Still in school?</h3>
          <p class="mt-2 text-[1.0625rem] text-neutral-200">
            Apply to our internship program and kickstart your career in the trades.
          </p>
        </div>

        <dl class="divide-y divide-line">
          {
            values.map((v) => (
              <div class="py-5 first:pt-0">
                <dt class="text-lg font-bold text-white">{v.title}</dt>
                <dd class="mt-1.5 text-[1.0625rem] leading-relaxed text-neutral-300">{v.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* Wire `action` to your applicant intake (email, ATS, or form handler) before launch. */}
      <form method="post" action="#" class="card p-7 sm:p-9">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClass}>Full name</label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class={fieldClass}
            />
          </div>
          <div>
            <label for="phone" class={labelClass}>Phone</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              required
              class={fieldClass}
            />
          </div>
        </div>
        <div class="mt-5">
          <label for="email" class={labelClass}>Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class={fieldClass}
          />
        </div>
        <div class="mt-5">
          <label for="role" class={labelClass}>I'm applying as</label>
          <select id="role" name="role" class={fieldClass}>
            <option>Journeyman electrician</option>
            <option>Apprentice electrician</option>
            <option>Laborer / dirt work</option>
            <option>Intern (student)</option>
            <option>Office / operations</option>
          </select>
        </div>
        <div class="mt-5">
          <label for="about" class={labelClass}>Tell us about your experience</label>
          <textarea id="about" name="about" rows="5" required class={fieldClass}></textarea>
        </div>
        <button type="submit" class="btn btn-solid mt-7 w-full sm:w-auto">Submit application</button
        >
        <p class="mt-4 text-sm text-neutral-400">
          Questions? Email{" "}
          <a href={`mailto:${site.email}`} class="link-red font-semibold underline">{site.email}</a
          >.
        </p>
      </form>
    </div>
  </section>
</Layout>
