---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTASection from "../components/CTASection.astro";
import { services } from "../data/site";

const steps = [
  [
    "Scope & estimate",
    "We walk the job, talk through your goals and budget, and put together a clear, itemized estimate — no surprises later.",
  ],
  [
    "Schedule & permitting",
    "We coordinate permits, inspections, and a schedule that works around your build or your business.",
  ],
  [
    "Install & inspect",
    "Our crew does the work to code, with safety inspections built into the process from start to finish.",
  ],
  [
    "Walkthrough & support",
    "We walk the finished work with you and stay available for questions and service long after.",
  ],
];
---

<Layout
  title="Services"
  description="Residential, commercial, industrial electrical, plus hauling and dirt work — from small projects to large remodels to brand-new builds."
>
  <PageHero
    eyebrow="Our services"
    title="Electrical work for every scope"
    lead="Small projects, large remodels, brand-new builds, and commercial work — handled with meticulous attention to detail and dedication to customer satisfaction."
  />

  <section class="section">
    <div class="container-page reveal grid gap-5 sm:grid-cols-2">
      {services.map((service, i) => <ServiceCard service={service} index={i + 1} detailed />)}
    </div>
  </section>

  <section class="section border-t border-line bg-ink-900">
    <div class="container-page grid gap-12 lg:grid-cols-[auto_1fr] lg:gap-20">
      <div class="reveal lg:max-w-xs">
        <p class="eyebrow">The process</p>
        <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white">
          How a project runs
        </h2>
      </div>
      <ol class="reveal border-t border-line">
        {
          steps.map(([title, body], i) => (
            <li class="flex flex-col gap-2 border-b border-line py-7 sm:flex-row sm:gap-8">
              <span class="font-mono text-sm font-bold text-red-400 sm:pt-1">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="text-h3 font-bold text-white">{title}</h3>
                <p class="mt-2 max-w-2xl text-[1.0625rem] leading-relaxed text-neutral-300">
                  {body}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTASection eyebrow="Get started" heading="Have a project in mind?" />
</Layout>
