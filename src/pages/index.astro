---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { cityStateZip, services, site, values } from "../data/site";

const trust = [
  "Locally owned & operated",
  "Safety-first crews",
  "Residential · Commercial · Industrial",
  site.serviceAreas.map((a) => a.replace(" County", "")).join(" · "),
];

const showcase = [
  {
    eyebrow: "How we work",
    title: "Solutions built around you",
    body: "We work closely with every client to tailor solutions that align with their individual needs, budgets, and desired outcomes — not a one-size-fits-all bid. You get technical expertise and hands-on project management from the first walkthrough.",
    href: "/services",
    linkText: "See our process",
    panelTitle: "On every project",
    panelPoints: [
      "A clear, itemized estimate up front",
      "One crew, one point of contact",
      "Permitting and inspections coordinated for you",
      "Work done to code, verified before we leave",
    ],
  },
  {
    eyebrow: "After the install",
    title: "Support that doesn't end at final inspection",
    body: "Ongoing support means you have a team to call long after the lights are on. We stand behind our work and keep the relationship open for the next remodel, the next building, the next phase.",
    href: "/contact",
    linkText: "Talk to our team",
    panelTitle: "Built for the long run",
    panelPoints: [
      "Service and maintenance agreements",
      "Priority scheduling for past clients",
      "Documentation handed over at close-out",
      "Straight answers when something comes up",
    ],
  },
];
---

<Layout business>
  {/* Hero — Framer-style display headline, Shamrock-style founding paragraph */}
  <section class="border-b border-white/10 bg-black">
    <div class="container-page py-24 sm:py-32">
      <p class="eyebrow">{site.address.city}, Colorado · Electrical Contractor</p>
      <h1
        class="mt-5 max-w-4xl text-5xl font-bold tracking-tight text-balance text-white sm:text-7xl"
      >
        Your trusted partner for all your electrical needs
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-pretty text-neutral-400 sm:text-xl">
        Rapid Energy Solutions is a locally owned electrical contractor serving residential,
        commercial, and industrial clients across the Front Range — with meticulous attention to
        detail and a safety-first crew on every job.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact" class="btn">Request service</a>
        <a href={site.phoneHref} class="btn">Call {site.phone}</a>
      </div>
      <div class="mt-10 h-0.5 w-16 bg-red-500"></div>
      <p class="mt-4 text-sm text-neutral-500">
        We look forward to creating a brighter future with you.
      </p>
    </div>
  </section>

  {/* Company overview — Shamrock "overview block" */}
  <section class="section">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <p class="eyebrow lg:pt-2">Who we are</p>
      <div class="space-y-5 text-lg text-pretty text-neutral-300">
        <p>
          Rising demand for quality electricians is real — and so is the gap in service that comes
          with it. We started Rapid Energy Solutions to close that gap: to give homeowners,
          businesses, and industrial clients a contractor who shows up, communicates clearly, and
          does the work right.
        </p>
        <p>
          From a small project to a large remodel to breaking ground on a new build, we bring the
          same standard: meticulous work for impeccable results.
        </p>
      </div>
    </div>
  </section>

  {/* Explore our services — Shamrock card grid + Stripe eyebrow */}
  <section class="section border-t border-white/10 bg-black">
    <div class="container-page">
      <p class="eyebrow">Our services</p>
      <h2
        class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-balance text-white sm:text-5xl"
      >
        One crew for the whole project
      </h2>
      <p class="mt-5 max-w-2xl text-pretty text-neutral-400">
        From a single circuit to a full renovation, our team has the experience to scope it, wire
        it, and stand behind it.
      </p>
      <div
        class="mt-14 grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4"
      >
        {services.map((service, i) => <ServiceCard service={service} index={i + 1} detailed />)}
      </div>
    </div>
  </section>

  {/* Trust marks — Shamrock logo row / Stripe logo bar */}
  <section class="border-t border-white/10">
    <div
      class="container-page grid divide-y divide-white/10 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x"
    >
      {
        trust.map((t) => (
          <p class="px-2 py-8 text-center text-xs font-semibold tracking-[0.14em] text-neutral-400 uppercase">
            {t}
          </p>
        ))
      }
    </div>
  </section>

  {/* Alternating showcase blocks — Shamrock two-column, Framer stack */}
  {
    showcase.map((block, i) => (
      <section class:list={["section border-t border-white/10", i % 2 === 1 && "bg-black"]}>
        <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
          <div class:list={[i % 2 === 1 && "lg:order-2"]}>
            <p class="eyebrow">{block.eyebrow}</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
              {block.title}
            </h2>
            <p class="mt-5 text-pretty text-neutral-400">{block.body}</p>
            <a href={block.href} class="btn mt-8">
              {block.linkText}
            </a>
          </div>
          <div class="border border-white/10 bg-neutral-900 p-8">
            <p class="text-xs font-semibold tracking-[0.15em] text-neutral-500 uppercase">
              {block.panelTitle}
            </p>
            <ul class="mt-5 space-y-4">
              {block.panelPoints.map((p) => (
                <li class="flex gap-3 border-t border-white/10 pt-4 text-sm text-neutral-300 first:border-0 first:pt-0">
                  <span class="mt-1.5 h-1 w-1 shrink-0 bg-red-500" />
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))
  }

  {/* Safety */}
  <section class="section border-t border-white/10 bg-black">
    <div class="container-page">
      <p class="eyebrow">Safety</p>
      <h2
        class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight text-balance text-white sm:text-5xl"
      >
        Protecting lives and preserving values
      </h2>
      <p class="mt-5 max-w-2xl text-pretty text-neutral-400">
        Safety is central to how we operate. Safety trainings and regular safety inspections protect
        our employees, our clients, and the communities we work in — on every job, no exceptions.
      </p>
      <dl class="mt-14 grid gap-px border border-white/10 bg-white/10 md:grid-cols-3">
        {
          values.map((v) => (
            <div class="bg-neutral-900 p-8">
              <dt class="text-lg font-semibold text-white">{v.title}</dt>
              <div class="mt-3 h-px w-10 bg-red-500" />
              <dd class="mt-4 text-sm leading-relaxed text-neutral-400">{v.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Careers CTA block — Shamrock "JOIN THE SHAMROCK FAMILY" */}
  <section class="border-t border-white/10">
    <div
      class="container-page flex flex-col gap-6 py-20 lg:flex-row lg:items-center lg:justify-between"
    >
      <div>
        <p class="eyebrow">Careers</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-white uppercase sm:text-5xl">
          Join the Rapid team
        </h2>
        <p class="mt-4 max-w-xl text-pretty text-neutral-400">
          We're a locally owned contractor committed to our employees, their families, and our
          communities. Electricians, apprentices, and students — there's a place for you.
        </p>
      </div>
      <a href="/careers" class="btn shrink-0">Apply now</a>
    </div>
  </section>

  <CTASection />
</Layout>
