---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Rapid Rebrand">
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-6 text-center">
    <p class="mb-4 text-sm font-medium tracking-widest text-neutral-500 uppercase">
      Rapid Rebrand
    </p>
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      Scaffold is ready. Start building.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-neutral-600 text-pretty">
      Astro + Tailwind are wired up. Edit <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-sm">src/pages/index.astro</code>
      and the page you see here changes.
    </p>
  </main>
</Layout>
