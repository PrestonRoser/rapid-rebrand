---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { cityStateZip, services, site, values } from "../data/site";

const trust = [
  "Locally owned & operated",
  "Safety-first crews",
  "Residential · Commercial · Industrial",
  `Serving ${site.serviceAreas.length} Colorado counties`,
];

const why = [
  {
    title: "Solutions built around you",
    body: "We work closely with every client to tailor solutions that fit their needs, budget, and desired outcome — not a one-size-fits-all bid.",
  },
  {
    title: "Managed start to finish",
    body: "Technical expertise and hands-on project management keep the schedule, the scope, and the crew moving in the same direction.",
  },
  {
    title: "Support after the lights are on",
    body: "Ongoing support means you have a team to call long after the final inspection is signed off.",
  },
];
---

<Layout business>
  {/* Hero */}
  <section class="relative overflow-hidden bg-brand-950 text-white">
    <div
      class="pointer-events-none absolute -top-32 -right-40 size-[36rem] rounded-full bg-brand-800/40 blur-3xl"
    >
    </div>
    <svg
      class="pointer-events-none absolute -right-16 bottom-0 hidden h-[115%] w-auto text-brand-800/50 lg:block"
      viewBox="0 0 200 300"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M118 0 40 168h56l-20 132 104-192h-58L118 0Z"></path>
    </svg>

    <div
      class="container-page relative grid gap-12 py-16 sm:py-24 lg:grid-cols-[1.4fr_1fr] lg:items-center"
    >
      <div>
        <p class="text-sm font-semibold tracking-[0.15em] text-accent-400 uppercase">
          {site.address.city}, Colorado
        </p>
        <h1 class="mt-3 max-w-2xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
          Your trusted partner for all your electrical needs
        </h1>
        <p class="mt-5 max-w-xl text-lg text-pretty text-brand-200">
          Rapid Energy Solutions delivers residential, commercial, and industrial electrical work
          with meticulous attention to detail — and a safety-first crew on every job.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Request service</a>
          <a href={site.phoneHref} class="btn btn-on-dark">Call {site.phone}</a>
        </div>
      </div>

      <div class="relative rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
        <p class="text-xs font-semibold tracking-[0.15em] text-accent-400 uppercase">
          Get in touch
        </p>
        <a
          href={site.phoneHref}
          class="mt-2 block text-2xl font-semibold text-white hover:text-accent-300"
        >
          {site.phone}
        </a>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
            <dt class="text-brand-400">Hours</dt>
            <dd class="text-right text-brand-100">Mon–Fri, 6:30a–5:00p</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
            <dt class="text-brand-400">Shop</dt>
            <dd class="text-right text-brand-100">{cityStateZip}</dd>
          </div>
          <div class="flex justify-between gap-4 border-t border-white/10 pt-3">
            <dt class="text-brand-400">Work</dt>
            <dd class="text-right text-brand-100">Res · Commercial · Industrial</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* Trust strip */}
  <section class="border-b border-brand-100 bg-white">
    <div class="container-page flex flex-wrap items-center justify-center gap-x-8 gap-y-3 py-6">
      {trust.map((t) => <span class="text-sm font-medium text-brand-600">{t}</span>)}
    </div>
  </section>

  {/* Services */}
  <section class="section">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-[0.15em] text-accent-600 uppercase">
          Our services
        </p>
        <h2
          class="mt-2 text-3xl font-semibold tracking-tight text-balance text-brand-950 sm:text-4xl"
        >
          One crew for the whole project
        </h2>
        <p class="mt-4 text-pretty text-brand-600">
          From a single circuit to breaking ground on a new build, our team has the experience to
          scope it, wire it, and stand behind it.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => <ServiceCard service={service} detailed />)}
      </div>
    </div>
  </section>

  {/* Why Rapid */}
  <section class="section bg-brand-50">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-[0.15em] text-accent-600 uppercase">Why Rapid</p>
        <h2
          class="mt-2 text-3xl font-semibold tracking-tight text-balance text-brand-950 sm:text-4xl"
        >
          Personalized service, impeccable results
        </h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          why.map((item) => (
            <div>
              <h3 class="text-lg font-semibold text-brand-950">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-brand-600">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Safety */}
  <section class="section">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="text-sm font-semibold tracking-[0.15em] text-accent-600 uppercase">Safety</p>
        <h2
          class="mt-2 text-3xl font-semibold tracking-tight text-balance text-brand-950 sm:text-4xl"
        >
          Protecting lives and preserving values
        </h2>
        <p class="mt-4 text-pretty text-brand-600">
          Safety is central to how we operate. Safety trainings and regular safety inspections
          protect our employees, our clients, and the communities we work in — on every job, no
          exceptions.
        </p>
      </div>
      <dl class="grid gap-6">
        {
          values.map((v) => (
            <div class="rounded-xl border border-brand-100 p-5">
              <dt class="font-semibold text-brand-950">{v.title}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-brand-600">{v.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Service area */}
  <section class="section bg-brand-50">
    <div class="container-page grid gap-8 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-sm font-semibold tracking-[0.15em] text-accent-600 uppercase">
          Service area
        </p>
        <h2
          class="mt-2 text-3xl font-semibold tracking-tight text-balance text-brand-950 sm:text-4xl"
        >
          Rooted in Platteville, working across the Front Range
        </h2>
        <p class="mt-4 text-pretty text-brand-600">
          Based at {site.address.street} in {site.address.city}, we serve residential, commercial,
          and industrial clients throughout the region.
        </p>
      </div>
      <ul class="grid grid-cols-2 gap-3">
        {
          site.serviceAreas.map((area) => (
            <li class="rounded-lg border border-brand-100 bg-white px-4 py-3 text-sm font-medium text-brand-800">
              {area}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection />
</Layout>
