---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import Reviews from "../components/Reviews.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { credentials, services, site, values } from "../data/site";
import { reviewSummary } from "../data/reviews";

const showcase = [
  {
    eyebrow: "How we work",
    title: "Solutions built around you",
    body: "We work closely with every client to tailor solutions that align with their individual needs, budgets, and desired outcomes, not a one-size-fits-all bid. You get technical expertise and hands-on project management from the first walkthrough.",
    href: "/services",
    linkText: "See our process",
    panelTitle: "On every project",
    panelPoints: [
      "A clear, itemized estimate up front",
      "One crew, one point of contact",
      "Permitting and inspections coordinated for you",
      "Work done to code, verified before we leave",
    ],
  },
  {
    eyebrow: "After the install",
    title: "Support that doesn't end at final inspection",
    body: "Ongoing support means you have a team to call long after the lights are on. We stand behind our work and keep the relationship open for the next remodel, the next building, the next phase.",
    href: "/contact",
    linkText: "Talk to our team",
    panelTitle: "Built for the long run",
    panelPoints: [
      "Service and maintenance agreements",
      "Priority scheduling for past clients",
      "Documentation handed over at close-out",
      "Straight answers when something comes up",
    ],
  },
];
---

<Layout business>
  {/* Hero */}
  <section class="relative overflow-hidden bg-ink-900">
    <div
      class="pointer-events-none absolute inset-0"
      style="background:radial-gradient(1100px 560px at 8% -20%, rgba(215,4,17,0.24), transparent 60%)"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-red-500/50 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-24 sm:py-32">
      <p class="eyebrow">{site.address.city}, Colorado · Electrical Contractor</p>
      <h1 class="mt-6 max-w-5xl text-hero leading-[0.98] font-bold tracking-tight text-balance">
        Your trusted partner for all your electrical needs
      </h1>
      <p class="mt-7 max-w-2xl text-lead text-pretty text-neutral-300">
        A locally owned electrical contractor serving residential, commercial, and industrial
        clients across the Front Range, with meticulous attention to detail and a safety-first crew
        on every job.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/contact" class="btn btn-solid">Request service</a>
        <a href={site.phoneHref} class="btn">Call {site.phone}</a>
      </div>

      {/* Rating sits under the CTAs, where it backs up the ask. */}
      <a
        href={reviewSummary.href}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-flex items-center gap-3 rounded-full border border-line bg-white/5 py-2.5 pr-5 pl-4 transition-colors hover:border-red-500/60"
      >
        <span class="flex gap-0.5 text-red-400" aria-hidden="true">
          {
            Array.from({ length: 5 }).map(() => (
              <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
              </svg>
            ))
          }
        </span>
        <span class="text-sm text-neutral-300">
          <span class="font-bold text-white">{reviewSummary.rating}</span>{" "}
          from {reviewSummary.count} reviews on {reviewSummary.source}
        </span>
      </a>
    </div>
  </section>

  {/* Credential strip */}
  <section class="border-y border-line bg-ink-800">
    <div
      class="container-page grid divide-y divide-line sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x"
    >
      {
        credentials.map((credential) => (
          <p class="flex min-h-20 items-center justify-center px-4 py-6 text-center text-sm font-bold tracking-[0.08em] text-neutral-300 uppercase">
            {credential}
          </p>
        ))
      }
    </div>
  </section>

  {/* Company overview */}
  <section class="section">
    <div class="container-page reveal grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-20">
      <p class="eyebrow lg:pt-3">Who we are</p>
      <div class="max-w-3xl space-y-6 text-lead text-pretty text-neutral-300">
        <p>
          Rising demand for quality electricians is real, and so is the gap in service that comes
          with it. We started Rapid Energy Solutions to close that gap: to give homeowners,
          businesses, and industrial clients a contractor who shows up, communicates clearly, and
          does the work right.
        </p>
        <p>
          From a small project to a large remodel to breaking ground on a new build, we bring the
          same standard: <span class="font-semibold text-white"
            >meticulous work for impeccable results</span
          >.
        </p>
      </div>
    </div>
  </section>

  {/* Services */}
  <section class="section border-t border-line bg-ink-900">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">Our services</p>
        <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white">
          One crew for the whole project
        </h2>
        <p class="mt-5 text-lead text-pretty text-neutral-300">
          From a single circuit to a full renovation, our team has the experience to scope it, wire
          it, and stand behind it.
        </p>
      </div>

      <div class="reveal mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service, index) => (
            <ServiceCard service={service} index={index + 1} detailed />
          ))
        }
      </div>
    </div>
  </section>

  <Reviews />

  {/* Alternating showcase blocks */}
  {
    showcase.map((block, index) => (
      <section class:list={["section border-t border-line", index % 2 === 1 && "bg-ink-900"]}>
        <div class="container-page reveal grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-20">
          <div class:list={[index % 2 === 1 && "lg:order-2"]}>
            <p class="eyebrow">{block.eyebrow}</p>
            <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white">
              {block.title}
            </h2>
            <p class="mt-5 text-lead text-pretty text-neutral-300">{block.body}</p>
            <a href={block.href} class="btn mt-9">
              {block.linkText}
            </a>
          </div>
          <div class="card p-8 sm:p-10">
            <p class="text-xs font-bold tracking-[0.18em] text-neutral-500 uppercase">
              {block.panelTitle}
            </p>
            <ul class="mt-6 space-y-5">
              {block.panelPoints.map((point) => (
                <li class="flex gap-4 border-t border-line pt-5 text-[1.0625rem] text-neutral-200 first:border-0 first:pt-0">
                  <svg
                    class="mt-1 size-5 shrink-0 text-red-400"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 10.5l4 4 8-9"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))
  }

  {/* Safety */}
  <section class="section border-t border-line bg-ink-900">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">Safety</p>
        <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-balance text-white">
          Protecting lives and preserving values
        </h2>
        <p class="mt-5 text-lead text-pretty text-neutral-300">
          Safety is central to how we operate. Safety trainings and regular safety inspections
          protect our employees, our clients, and the communities we work in, on every job, no
          exceptions.
        </p>
      </div>
      <dl class="reveal mt-14 grid gap-5 md:grid-cols-3">
        {
          values.map((value) => (
            <div class="card p-8">
              <dt class="text-h3 font-bold text-white">{value.title}</dt>
              <span class="keyline mt-4" />
              <dd class="mt-5 text-[1.0625rem] leading-relaxed text-neutral-300">{value.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Careers */}
  <section class="border-t border-line">
    <div
      class="container-page reveal flex flex-col gap-8 py-20 lg:flex-row lg:items-center lg:justify-between"
    >
      <div>
        <p class="eyebrow">Careers</p>
        <h2 class="mt-5 text-h2 leading-[1.05] font-bold tracking-tight text-white uppercase">
          Join the Rapid team
        </h2>
        <p class="mt-5 max-w-xl text-lead text-pretty text-neutral-300">
          We're a locally owned contractor committed to our employees, their families, and our
          communities. Electricians, apprentices, and laborers: there's a place for you.
        </p>
      </div>
      <a href="/careers" class="btn shrink-0">Apply now</a>
    </div>
  </section>

  <CTASection />
</Layout>
